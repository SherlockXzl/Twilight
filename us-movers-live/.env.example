# 复制成 .env 后可省掉每次手打环境变量。**真实环境变量优先于本文件。**
# .env 已在 .gitignore 里，不要提交。

PORT=8787

# 数据源：alpaca（默认，夜盘口径，需要下面两个密钥）/ mock（离线演示）
SOURCE=alpaca

# Alpaca 夜盘行情 —— 免费 Paper 账号即可（全球可注册、只需邮箱）
# 拿 Key：登录 alpaca.markets → 右上角侧栏 API Keys
ALPACA_KEY_ID=
ALPACA_SECRET_KEY=

# 夜盘进行中的轮询间隔（秒）。一轮扫描实测 20~90 秒，间隔不能比它短。
NIGHT_POLL_SECONDS=180

# 只看上涨（默认 0）。设为 1 会恢复下跌档。
SHOW_DOWN=0

# 分档口径（美元 / 百分点）
BIG_MIN_CAP_USD=10000000000
MID_MIN_CAP_USD=1500000000
BIG_PCT=4
MID_PCT=10
